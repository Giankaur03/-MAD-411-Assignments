<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/headerContainer"
        android:layout_width="369dp"
        android:layout_height="79dp"
        android:layout_margin="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <EditText
        android:id="@+id/editExpencename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Name"
        android:inputType="text"
        android:text=" " />

    <EditText
        android:id="@+id/editAmount"
        android:layout_width="350dp"
        android:layout_height="65dp"
        android:hint="Amount"
        android:ems="10"
        android:inputType="text"
        android:text=" " />

    <EditText
        android:id="@+id/editdate"
        android:layout_width="350dp"
        android:layout_height="65dp"
        android:ems="10"
        android:inputType="text"
        android:text="Date" />

    <Button
        android:id="@+id/button_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Expence" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/buttonFinancialTips"
        android:layout_width="147dp"
        android:layout_height="71dp"
        android:layout_margin="1dp"
        android:layout_marginStart="119dp"
        android:layout_marginTop="435dp"
        android:layout_marginEnd="108dp"
        android:layout_marginBottom="199dp"
        android:text="Financial Tips!"
        app:layout_constraintBottom_toBottomOf="@+id/recyclerViewExpenses"
        app:layout_constraintEnd_toEndOf="@+id/recyclerViewExpenses"
        app:layout_constraintHorizontal_bias="0.475"
        app:layout_constraintStart_toEndOf="@+id/recyclerViewExpenses"
        app:layout_constraintStart_toStartOf="@+id/recyclerViewExpenses"
        app:layout_constraintTop_toTopOf="@+id/recyclerViewExpenses"
        app:layout_constraintVertical_bias="1.0" />

</LinearLayout>
